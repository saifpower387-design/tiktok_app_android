rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    // Financial records: balances and transaction writes are server-only.
    match /wallets/{uid} {
      allow read: if own(uid);
      allow write: if false;
    }
    match /withdrawalRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /giftTransactions/{giftId} {
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }
    match /adRevenueEvents/{eventId} {
      allow read, write: if false;
    }

    // App collections (match the paths used by lib/main.dart).
    // usernames/{name}: lets login-by-username work before sign-in.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if own(uid);
      // Owner edits freely; others may only touch follower/following counters.
      allow update: if own(uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['followersCount', 'followingCount']));

      match /followers/{id} { allow read, write: if signedIn(); }
      match /following/{id} { allow read, write: if signedIn(); }
      match /savedVideos/{id} { allow read, write: if own(uid); }
      match /notifications/{id} {
        allow read, update, delete: if own(uid);
        allow create: if signedIn();
      }
    }

    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      // Owner edits anything; others may only change like/comment counters.
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likesCount', 'commentsCount']));

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if own(uid);
      }
      match /comments/{commentId} {
        allow read, create: if signedIn();
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
