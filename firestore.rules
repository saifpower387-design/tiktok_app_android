rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }

    // Financial records: balances and transaction writes are server-only.
    match /wallets/{uid} {
      allow read: if own(uid);
      allow write: if false;
    }
    match /withdrawalRequests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /giftTransactions/{giftId} {
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }
    match /adRevenueEvents/{eventId} {
      allow read, write: if false;
    }

    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if own(uid);
      allow update: if own(uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['followersCount', 'followingCount']));

      // A user can manage only their own following list. A follower record can
      // only be created/deleted by the account represented by its document id.
      match /followers/{id} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == id;
        allow update: if false;
      }
      match /following/{id} {
        allow read: if signedIn();
        allow create: if own(uid) && request.resource.data.userId == id;
        allow delete: if own(uid);
        allow update: if false;
      }
      match /savedVideos/{id} { allow read, write: if own(uid); }

      // Social notifications are client-created for now, but the actor must be
      // the authenticated user and only the expected fields may be written.
      match /notifications/{id} {
        allow read, update, delete: if own(uid);
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.keys().hasAll(['title', 'body', 'type', 'actorId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'actorId', 'createdAt']);
      }
    }

    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likesCount', 'commentsCount']));

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if own(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read, create: if signedIn();
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
